+        }
+        if (memory->prefix_unified && memory->prefix_used(next) > prefix_context_limit) {
+            throw std::runtime_error("restored PrefixLM KV exceeds requested capacity");
+        }
+        memory->prefix_sequences = std::move(next);
+        n_outputs = 0;
+    } catch (...) {
