diff --git a/include/llama.h b/include/llama.h
index 3ab935939..0887f08a1 100644
--- a/include/llama.h
+++ b/include/llama.h
@@ -665,6 +665,10 @@ extern "C" {
     // Returns true if the model is diffusion-based (like LLaDA, Dream, etc.)
     LLAMA_API bool llama_model_is_diffusion(const struct llama_model * model);
 
+    // Returns true if the model supports a bidirectional prompt followed by causal generation.
+    // Callers select the attention mode with llama_set_causal_attn().
+    LLAMA_API bool llama_model_is_prefix_lm(const struct llama_model * model);
+
     // Returns 0 on success
     LLAMA_API uint32_t llama_model_quantize(
             const char * fname_inp,
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index ef53728d1..66bf31308 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -1663,8 +1663,13 @@ int llama_context::decode(const llama_batch & batch_inp) {
         return encode(batch_inp);
     }
 
-    if (batch_inp.n_tokens == 0) {
-        LLAMA_LOG_ERROR("%s: n_tokens == 0\n", __func__);
+    if (batch_inp.n_tokens <= 0 || uint32_t(batch_inp.n_tokens) > cparams.n_batch) {
+        LLAMA_LOG_ERROR("%s: invalid batch size %d (maximum %u)\n", __func__, batch_inp.n_tokens, cparams.n_batch);
+        return -1;
+    }
+    if (!cparams.causal_attn && uint32_t(batch_inp.n_tokens) > cparams.n_ubatch) {
+        LLAMA_LOG_ERROR("%s: non-causal input (%d tokens) must fit in one physical batch (%u tokens)\n",
+                __func__, batch_inp.n_tokens, cparams.n_ubatch);
         return -1;
     }
 
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 3607bacd6..208b04135 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -3214,6 +3214,10 @@ bool llama_model_is_diffusion(const llama_model * model) {
     return llm_arch_is_diffusion(model->arch);
 }
 
+bool llama_model_is_prefix_lm(const llama_model * model) {
+    return model->hparams.hrm_prefix_lm;
+}
+
 const std::vector<std::pair<std::string, ggml_tensor *>> & llama_internal_get_tensor_map(const llama_model * model) {
     return model->tensors_by_name;
 }
diff --git a/src/models/hrm-text.cpp b/src/models/hrm-text.cpp
index 4a9a67b6c..74eca90f5 100644
--- a/src/models/hrm-text.cpp
+++ b/src/models/hrm-text.cpp
@@ -11,7 +11,7 @@ void llama_model_hrm_text::load_arch_hparams(llama_model_loader & ml) {
     ml.get_key(LLM_KV_HRM_H_CYCLES, hparams.n_hrm_h_cycles);
     ml.get_key(LLM_KV_HRM_L_CYCLES, hparams.n_hrm_l_cycles);
 
-    // prefix-LM prefill is not implemented (causal attention only); kept for round-trip
+    // Callers select noncausal prefill and causal generation explicitly.
     ml.get_key(LLM_KV_HRM_PREFIX_LM, hparams.hrm_prefix_lm, false);
 
     GGML_ASSERT(hparams.n_hrm_layers_per_stack > 0);
